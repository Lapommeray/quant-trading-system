# ============================================================
# .env.example - copy to .env and fill in real values.
# The real .env is gitignored and MUST NEVER be committed.
# ============================================================

# ---- OKX (primary venue) ----
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
# Passphrase set when creating the OKX API key (required for any signed call).
OKX_PASSPHRASE=your_okx_api_passphrase
# Fail-closed: keep false. Real order placement requires human activation.
OKX_LIVE_TRADING=false
OKX_ALLOW_PAPER_FOR_TEST=true

# ---- Risk caps ----
OKX_MAX_LEVERAGE=3.0
OKX_MAX_POSITION_PCT=0.10
OKX_MAX_DAILY_LOSS_PCT=0.03
OKX_MAX_ORDERS_PER_MIN=20

# ---- Symbols ----
QT_DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT

# ---- S&P 500 feed ----
TWELVEDATA_API_KEY=
SPX_POLL_SECONDS=10
